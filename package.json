{
	"name": "wav2bar-reborn",
	"version": "1.0.0-beta.1",
	"private": true,
	"author": {
		"name": "Charly Schmidt aka 'Picorims'",
		"email": "picorims.contact@gmail.com",
		"url": "https://picorims.github.io"
	},
	"license": "MPL-2.0",
	"scripts": {
		"tauri:dev": "env RUST_BACKTRACE=1 npx tauri dev",
		"dev": "vite dev",
		"devo": "vite dev --open",
		"build": "vite build",
		"tauri:build:r": "npx tauri build",
		"tauri:build:d": "npx tauri build --debug",
		"preview": "vite preview",
		"test": "npm run test:unit",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "eslint .",
		"format:check": "prettier --check .",
		"format": "prettier --write .",
		"test:unit": "npx vitest",
		"json2ts": "npx json2ts -i ./src/lib/schemas/ -o ./src/lib/types/schemas",
		"ajv:build-schemas": "node scripts/build_schemas.js && echo 'Running Prettier on generated files...' && prettier --write src/lib/schemas/compiled/*",
		"prepare": "husky"
	},
	"devDependencies": {
		"@sveltejs/adapter-static": "^3.0.2",
		"@sveltejs/kit": "^2.69.1",
		"@sveltejs/vite-plugin-svelte": "^5.1.1",
		"@tauri-apps/cli": "^2.4.0",
		"@types/eslint": "^8.56.7",
		"@types/node": "^24.10.1",
		"ajv-cli": "^5.0.0",
		"eslint": "^9.39.4",
		"eslint-config-prettier": "^9.1.0",
		"eslint-plugin-svelte": "^3.2.0",
		"globals": "^15.0.0",
		"husky": "^9.1.7",
		"json-schema-to-typescript": "^15.0.4",
		"prettier": "^3.1.1",
		"prettier-plugin-svelte": "^3.2.6",
		"sass": "^1.101.0",
		"svelte": "^5.56.4",
		"svelte-check": "^4.7.1",
		"tslib": "^2.4.1",
		"typescript": "^5.5.0",
		"typescript-eslint": "^8.62.1",
		"vite": "6.4",
		"vite-plugin-checker": "^0.11.0",
		"vitest": "^4.1.9"
	},
	"type": "module",
	"dependencies": {
		"@tauri-apps/api": "^2.4.0",
		"@tauri-apps/plugin-dialog": "^2.4.0",
		"@tauri-apps/plugin-fs": "^2.4.4",
		"@tauri-apps/plugin-log": "^2.3.1",
		"@tauri-apps/plugin-opener": "^2.2.6",
		"@tauri-apps/plugin-os": "^2.3.2",
		"@tauri-apps/plugin-shell": "^2.3.5",
		"@zip.js/zip.js": "^2.7.45",
		"ajv": "^8.20.0",
		"lucide-svelte": "^0.428.0",
		"pixi-filters": "^6.1.5",
		"pixi.js": "^8.18.1",
		"svelte-splitpanes": "^8.0.9"
	},
	"overrides": {
		"fast-json-patch": "3.1.1"
	}
}
