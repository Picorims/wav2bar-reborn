{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "log:allow-log",
    "log:default",
    "opener:default",
    "opener:allow-open-path",
    "dialog:default",
    "fs:default",
    "fs:allow-lstat",
    {
      "identifier": "fs:allow-read-file",
      "allow": [
        "**"
      ]
    },
    "os:default",
    "shell:default",
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "ffmpeg",
          "cmd": "ffmpeg.exe",
          "args": true
        }
      ]
    }
  ]
}