{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"title": "Le schéma",
	"description": "La description",
	"definitions": {
		"angle_degrees_int": {
			"description": "degrees, clockwise. 0 and 360 may have a different meaning.",
			"type": "integer",
			"minimum": 0,
			"maximum": 360
		},
		"some_object": {
			"type": "object",
			"properties": {
				"nested_object": {
					"type": "object",
					"properties": {
						"type": {
							"type": "string",
							"enum": [
								"reponse_a",
								"reponse_b"
							],
							"default": "reponse_a"
						}
					}
				},
				"une_ref": {
					"$ref": "#/definitions/angle_degrees_int",
					"const": 85
				},
				"tableau": {
					"type": "array",
					"items": {
						"type": "integer"
					},
					"minItems": 2,
					"default": [
						0,
						0
					]
				}
			},
			"required": ["une_ref", "tableau"]
		}
	}
}